# Dockerfile de producción para Railway
FROM python:3.11-slim

# Establecer directorio de trabajo
WORKDIR /app

# Variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Instalar dependencias del sistema para MySQL
RUN apt-get update && apt-get install -y \
    default-libmysqlclient-dev \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements y instalar dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar el código de la aplicación
COPY . .

# Recolectar archivos estáticos
RUN python manage.py collectstatic --noinput || true

# Exponer puerto (Railway usa el puerto de la variable PORT)
EXPOSE 8000

# Comando de inicio con gunicorn
# Railway proporciona la variable PORT automáticamente
CMD gunicorn refugio_api.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2 --timeout 120

